# GoodFolder environment. Copy to .env beside docker-compose.yml and fill in.
# Never commit the real .env.
#
# Every variable the stack reads is listed here. Ones marked OPTIONAL have a
# working default and can be left as they are for a self-hosted setup.

# --- SECRETS YOU MUST SET ---------------------------------------------------
# Any long random strings. Generate with: openssl rand -hex 32
GOODFOLDER_DB_PASSWORD=CHANGE_ME
GITEA_DB_PASSWORD=CHANGE_ME
GITEA_SECRET_KEY=CHANGE_ME
GITEA_ADMIN_PASSWORD=CHANGE_ME

# --- WHERE THIS SERVER LIVES ------------------------------------------------
# The address people and the CLI reach this control plane on. Point the CLI at
# it with GF_API_URL. Default: https://api.trygoodfolder.com
PUBLIC_URL=http://localhost:4100

# Browser origins allowed to call the API, comma-separated. localhost and
# *.pages.dev are always permitted, so a local dashboard needs nothing here.
WEB_ORIGINS=

# --- PORTS (OPTIONAL) -------------------------------------------------------
# Control plane defaults to 4100, large-file service to 4101.
PORT=

# --- LARGE FILES ------------------------------------------------------------
# Where the control plane reaches the large-file service internally.
# Default: http://127.0.0.1:4101 (compose sets the in-network address).
LFS_INTERNAL_URL=http://goodfolder-lfs:4101

# The address clients are told to upload to. Default: http://127.0.0.1:$PORT
PUBLIC_LFS_ORIGIN=http://localhost:4101

# PRESIGN=1 hands clients presigned URLs so file data never passes through
# this server. Recommended. Leave empty to stream through instead.
PRESIGN=1

# When presigning behind a private network name, the address clients should be
# given instead of the internal one. OPTIONAL.
PRESIGN_PUBLIC_ENDPOINT=

# --- OBJECT STORAGE ---------------------------------------------------------
# MinIO ships in docker-compose, so a self-hosted setup needs no cloud account.
# For Cloudflare R2 or another S3 provider, replace the endpoint and keys.
S3_ENDPOINT=http://goodfolder-minio:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=goodfolder

# --- GITEA (INTERNAL TRANSPORT, NEVER EXPOSED) ------------------------------
GITEA_INTERNAL_URL=http://goodfolder-gitea:3000
GITEA_ADMIN_USER=gf-service

# --- SIGN-IN EMAIL (OPTIONAL) -----------------------------------------------
# Without a key, sign-in still works: the one-time link is written to the
# server log instead, so read it with `docker compose logs goodfolder-api`.
# That is a perfectly usable single-operator setup.
RESEND_API_KEY=
MAIL_FROM=GoodFolder <onboarding@resend.dev>

# MAGIC_LINK_DEBUG=1 returns the sign-in link in the API response. Convenient
# locally, unsafe on anything reachable from outside. OPTIONAL.
MAGIC_LINK_DEBUG=

# --- AI SAVE LABELS (OPTIONAL) ----------------------------------------------
# Without a key, saves still work and fall back to a plain generated summary.
# A label must never block a save.
OPENROUTER_API_KEY=
LABEL_MODEL=

# --- DEVELOPMENT ROUTES (OPTIONAL) ------------------------------------------
# When set, /api/dev/* requires this value in an x-gf-dev-key header. Unset
# leaves those routes open, which is only safe on a private machine.
DEV_API_KEY=
