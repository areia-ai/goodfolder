# Control plane, run from source against the docker-compose.dev.yml
# infrastructure. Copy to apps/control-plane/.env.dev and fill CHANGE_ME —
# the same value you gave GOODFOLDER_DB_PASSWORD / GITEA_ADMIN_PASSWORD in
# the stack's .env.

DATABASE_URL=postgres://goodfolder:CHANGE_ME@localhost:5432/goodfolder
PORT=4100

PUBLIC_URL=http://localhost:4100
WEB_URL=http://localhost:4300

GITEA_INTERNAL_URL=http://localhost:3000
GITEA_ADMIN_USER=gf-service
GITEA_ADMIN_PASSWORD=CHANGE_ME

S3_ENDPOINT=http://localhost:9100
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=goodfolder

PUBLIC_LFS_ORIGIN=http://localhost:4101
LFS_INTERNAL_URL=http://localhost:4101
PRESIGN=1
PRESIGN_PUBLIC_ENDPOINT=http://localhost:9100

# Returns the sign-in link in the API response. Convenient on your own
# machine; never set it on anything reachable from outside.
MAGIC_LINK_DEBUG=1

BILLING_MODE=disabled
BILLING_ENFORCEMENT=observe
